# Public analytics. Leave empty to disable PostHog locally.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Newsletter signup and broadcast email.
# For designer preview deploys, leave these empty unless using a test Resend
# audience/key. Never put production email credentials in preview projects.
RESEND_API_KEY=
RESEND_FULL_ACCESS_API_KEY=
RESEND_AUDIENCE_ID=
BROADCAST_SECRET=
